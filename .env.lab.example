# Lab environment template — cache paths for large-disk mounts.
#
# Copy to `.env` and adjust paths to your actual large volume. The container does not
# auto-load this file; pass it with `--env-file .env`.
#
# Run `df -h` and `findmnt` to find your real large disk — a path named /mnt proves nothing.

# HuggingFace model and dataset caches. Without these, everything lands on the (small) root FS.
HF_HOME=/mnt/hf
HF_DATASETS_CACHE=/mnt/hf/datasets

# Temp files and Halo scratch (S3 dataset cache, profiler output).
TMPDIR=/mnt/tmp
HALO_DATA_ROOT=/mnt

# Optional: Weights & Biases (leave blank to disable).
WANDB_API_KEY=

# Optional: HuggingFace Hub token for gated models (leave blank for public models only).
HF_TOKEN=

# Optional: AWS credentials for s3:// datasets (leave blank if not using S3).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
